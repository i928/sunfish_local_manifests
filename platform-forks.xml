<?xml version="1.0" encoding="UTF-8"?>
<!--
  Platform repos (AOSP / Evolution X / LineageOS) pinned to i928 forks.

  Two kinds of pin:
  * evo-a16: upstream bka plus our patches. When Evo moves bka forward, rebase
    the patches onto it and push, or the tree stays on the old base.
  * bka (or lineage-23.2): a plain mirror of upstream, pinned so lopro104's
    commits can be taken later without touching this file again. GitHub does
    not update a fork by itself: run "gh repo sync i928/NAME -b bka" before a
    repo sync, or the tree silently falls behind Evo. Once a mirror gets our
    own commits, move them to an evo-a16 branch and switch the pin.

  AdServices: android.ext.adservices visibility for //device/xiaomi, needed by
  lmi's extra-apps prebuilts (uses-library). //device/google is upstream already.
  frameworks/av: "CameraService: only attempt the ext library load once".

  lopro104 carries commits on these (checked 2026-09-16):
  hardware_interfaces bka +6 (restore q/android-4.9, FCM p/android-4.4,
  soundtrigger 2.2, viperfx aidl, wifi_chip log noise, health battery poll);
  hardware_google_pixel cnb +2 (thermal uevent buffer, powerstats; none on bka).
  His hardware_mainline_common lineage-23.2 commit rewrites libpixelusb-aidl to
  //hardware/google/pixel/usb, which does NOT resolve on bka: here the namespace
  is hardware/google/pixel itself. Do not take it on bka.
-->
<manifest>
  <remove-project name="platform/packages/modules/AdServices" />
  <project path="packages/modules/AdServices" name="android_packages_modules_AdServices"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="i928" revision="evo-a16" />

  <!-- frameworks/av + frameworks/opt/telephony: branch evo-a16-1013 (2026-10-13) =
       Evo's rewritten bka + our one commit each (camera ext load once / RIL log).
       The old evo-a16 / bka branches are retired. -->
  <remove-project name="frameworks_av" />
  <project path="frameworks/av" name="frameworks_av"
           groups="pdk,sysui-studio" remote="i928" revision="evo-a16-1013" />

  <!-- frameworks/opt/telephony from the i928 fork, branch bka (2026-10-05): Evo bka
       (17988547fd) + da92dcab15 "RIL: log requests unsupported by the radio HAL
       once, at debug level" (silences the per-boot RILJ "not supported on
       service" errors on old radio HALs). When Evo bka moves, rebase onto it. -->
  <remove-project name="frameworks_opt_telephony" />
  <project path="frameworks/opt/telephony" name="frameworks_opt_telephony"
           groups="pdk,sysui-studio" remote="i928" revision="evo-a16-1013" />

  <!-- frameworks/base: i928 evo-a16 (2026-10-13) = Evo bka 173b21e1a (Evo rewrote
       bka; the old i928 bka is kept but retired) + our 5 commits: USB mode picker
       default, AudioService 500 ms delay, battery saver while plugged in (state
       machine + PowerManagerService guard), SleepMode saved state across reboots.
       Evo Settings bka needs this Evo base (PixelDeviceRepository/TrickyStoreService
       constants). When Evo moves bka, replay the 5 commits onto it. -->
  <remove-project name="frameworks_base" />
  <project path="frameworks/base" name="frameworks_base"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="i928" revision="evo-a16-1016" />

  <!-- frameworks/native: i928 evo-a16 (2026-10-15) = Evo bka 8a54c845 + "installd: run
       in the top-app cpuset and boost group" (shorter user unlock). When Evo bka
       moves, rebase onto it. -->
  <remove-project name="frameworks_native" />
  <project path="frameworks/native" name="frameworks_native"
           groups="pdk" remote="i928" revision="evo-a16" />

  <!-- packages/apps/Settings: i928 evo-a16 = Evo bka + "Settings: allow toggling
       battery saver while plugged in" (pairs with frameworks/base bka 0b0559dce).
       When Evo bka moves, rebase onto it. -->
  <remove-project name="packages_apps_Settings" />
  <project path="packages/apps/Settings" name="packages_apps_Settings"
           groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="i928" revision="evo-a16-1024" />

  <remove-project name="hardware_interfaces" />
  <project path="hardware/interfaces" name="hardware_interfaces"
           groups="pdk,sysui-studio" remote="i928" revision="bka" />

  <remove-project name="hardware_google_pixel" />
  <project path="hardware/google/pixel" name="hardware_google_pixel"
           groups="generic_fs,pixel,pdk-gs-arm,pdk-gs-imgtec,pdk-desktop" remote="i928" revision="bka" />

  <!-- Not in Evo's manifest; new project. Its root is its own soong namespace,
       so nothing from it is installed unless a device adds it to
       PRODUCT_SOONG_NAMESPACES. No module name clashes in the evo tree. -->
  <project path="hardware/mainline/common" name="android_hardware_mainline_common"
           remote="i928" revision="lineage-23.2" />

  <!-- packages/apps/Updater: i928 resume-restart = Evo bka + "Updater: restart a
       download that has no partial file on resume" (stuck after a SourceForge 404). -->
  <remove-project name="packages_apps_Updater" />
  <project path="packages/apps/Updater" name="packages_apps_Updater"
           remote="i928" revision="resume-restart" />

  <!-- packages/modules/Wifi: i928 evo-a16 = Evo bka + WPA3 Transition Disable keeps the PSK
       when the SAE auto-upgrade is off (sunfish config_wifiSaeUpgradeEnabled=false). -->
  <remove-project name="packages_modules_Wifi" />
  <project path="packages/modules/Wifi" name="packages_modules_Wifi"
           groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="i928" revision="evo-a16" />

  <!-- Old-kernel fixes for crosshatch (msm-4.9); harmless on sunfish (4.14).
       Connectivity: i928 android_packages_modules_Connectivity evo-a16 = Evo bka + netd
       cgroup skb attach on old kernels + 4.9 socket create/bind hook variants (Evo's
       dbb8c0a already relaxes netbpfload and forces isAtLeast25Q2() false).
       bionic: i928 android_bionic evo-a16 = Evo bka + epoll_pwait2 / close_range CLOEXEC
       ENOSYS fallbacks. libmeminfo needs nothing: Evo already checks the gpuMem map.
       Both live in the LineageOS-fork repos (GitHub allows one fork per network). -->
  <remove-project name="packages_modules_Connectivity" />
  <project path="packages/modules/Connectivity" name="android_packages_modules_Connectivity"
           groups="pdk-cw-fs,pdk-fs" remote="i928" revision="evo-a16" />
  <remove-project name="bionic" />
  <project path="bionic" name="android_bionic" groups="pdk" remote="i928" revision="evo-a16" />
  <!-- hardware/qcom/audio: i928 cirrus-pthread = LineageOS lineage-23.2 (what Evo uses)
       + cirrus thread routines with the pthread start signature (crosshatch). -->
  <remove-project name="LineageOS/android_hardware_qcom_audio" />
  <project path="hardware/qcom/audio" name="android_hardware_qcom_audio"
           groups="qcom,qcom_audio,pdk-qcom" remote="i928" revision="cirrus-pthread" />
  <!-- system/core: i928 system_core evo-a16 = Evo bka (1429ff9) + 7f2940a "init: Don't wipe
       the user's /data/adb module data" (drops Evo's one-time rm -rf of /data/adb/tricky_store,
       playintegrityfix, gameprops; only SELinux stopped it on sunfish 2026-10-28). bka = mirror. -->
  <remove-project name="system_core" />
  <project path="system/core" name="system_core" groups="pdk" remote="i928" revision="evo-a16" />
</manifest>
